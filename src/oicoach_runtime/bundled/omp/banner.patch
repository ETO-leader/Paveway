diff --git a/packages/tui/src/prompt/welcome-presentation.ts b/packages/tui/src/prompt/welcome-presentation.ts
new file mode 100644
--- /dev/null
+++ b/packages/tui/src/prompt/welcome-presentation.ts
@@ -0,0 +1,36 @@
+// Opt-in terminal welcome policy. Hosts without a registered renderer are unchanged.
+export interface WelcomePresentation {
+	readonly introMs: number;
+	render(width: number, version: string, progress: number): string[];
+}
+
+let presentation: WelcomePresentation | undefined;
+let motionEnabled: boolean | undefined;
+let introPlayed = false;
+const motionListeners = new Set<() => void>();
+
+export function setWelcomePresentation(value: WelcomePresentation): void {
+	presentation = value;
+}
+export function getWelcomePresentation(): WelcomePresentation | undefined {
+	return presentation;
+}
+export function getWelcomeMotion(): boolean | undefined {
+	return motionEnabled;
+}
+export function setWelcomeMotionEnabled(enabled: boolean): void {
+	motionEnabled = enabled;
+	for (const listener of [...motionListeners]) listener();
+}
+export function watchWelcomeMotion(listener: () => void): () => void {
+	motionListeners.add(listener);
+	return () => { motionListeners.delete(listener); };
+}
+export function hasWelcomeIntroPlayed(): boolean {
+	return introPlayed;
+}
+export function claimWelcomeIntro(): boolean {
+	if (introPlayed) return false;
+	introPlayed = true;
+	return true;
+}
