index 0000000000..b1f72296a0
--- /dev/null
+++ b/packages/tui/test/conversation-presentation.test.ts
@@ -0,0 +1,183 @@
+import { afterEach, beforeAll, describe, expect, it } from "bun:test";
+import type { AssistantMessage } from "@oh-my-pi/pi-ai";
+import { AssistantMessageComponent } from "../src/chat/assistant-message";
+import { UserMessageComponent } from "../src/chat/user-message";
+import { getConversationPresentation, setConversationPresentation } from "../src/chat/conversation-presentation";
+import { trimBlankEdges } from "../src/chrome/transcript-container";
+import { initTheme, theme } from "../src/theme";
+import { stripTerminalSequences, visibleWidth } from "../src/utils";
+
+beforeAll(async () => { await initTheme(false); });
+afterEach(() => { setConversationPresentation(undefined); });
+
+const brand = (value: string) => theme.fg("accent", value);
+const policy = { user: { compact: true, accent: brand }, assistant: { label: "GPT", labelColor: brand } };
+const plain = (rows: readonly string[]) => rows.map(stripTerminalSequences);
+
+function message(content: AssistantMessage["content"]): AssistantMessage {
+	return {
+		role: "assistant", content, api: "anthropic-messages", provider: "anthropic", model: "claude-sonnet-4-5",
+		usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } },
+		stopReason: "stop", timestamp: 1,
+	};
+}
+
+function textMessage(text: string): AssistantMessage {
+	return message([{ type: "text", text }]);
+}
+
+describe("opt-in native conversation presentation", () => {
+	it("keeps the stock presentation by default and restores it on undefined", () => {
+		const stockUser = new UserMessageComponent("hello").render(40);
+		const stockAssistant = new AssistantMessageComponent(textMessage("hello")).render(40);
+		setConversationPresentation(policy);
+		expect(plain(new UserMessageComponent("hello").render(40))[0]).toStartWith("▏ hello");
+		expect(plain(new AssistantMessageComponent(textMessage("hello")).render(40))[0]).toStartWith("  GPT");
+		expect(plain(new AssistantMessageComponent(textMessage("hello")).render(40))[1]).toStartWith("  hello");
+		expect(setConversationPresentation(undefined)).toBe(true);
+		expect(new UserMessageComponent("hello").render(40)).toEqual(stockUser);
+		expect(new AssistantMessageComponent(textMessage("hello")).render(40)).toEqual(stockAssistant);
+	});
+
+	it("snapshots policy and treats equivalent policies as a no-op", () => {
+		expect(setConversationPresentation(policy)).toBe(true);
+		expect(setConversationPresentation(policy)).toBe(false);
+		expect(setConversationPresentation({ user: { ...policy.user }, assistant: { ...policy.assistant } })).toBe(false);
+		const snapshot = getConversationPresentation();
+		expect(Object.isFrozen(snapshot)).toBe(true);
+		expect(Object.isFrozen(snapshot?.user)).toBe(true);
+		const user = new UserMessageComponent("hello");
+		const assistant = new AssistantMessageComponent();
+		setConversationPresentation(undefined);
+		assistant.updateContent(textMessage("answer"));
+		expect(plain(user.render(40))[0]).toStartWith("▏ hello");
+		expect(plain(assistant.render(40))[0]?.trim()).toBe("GPT");
+		assistant.dispose();
+	});
+
+	it("renders short prompts on one line, without painting the user bubble background", () => {
+		setConversationPresentation(policy);
+		const user = new UserMessageComponent("hello");
+		const rows = user.render(40);
+		expect(rows).toHaveLength(1);
+		expect(plain(rows)[0]?.trimEnd()).toBe("▏ hello");
+		expect(rows.join("")).not.toContain(theme.getBgAnsi("userMessageBg"));
+		expect(user.render(40)).toBe(rows);
+		expect(rows[0]).toContain("\x1b]133;A\x07");
+		expect(rows[0]).toContain("\x1b]133;D;0\x07");
+	});
+
+	it("does not overwrite the first prompt row with steering or reaction badges", () => {
+		setConversationPresentation(policy);
+		const user = new UserMessageComponent("keep this text", { liveSteered: true });
+		user.setReaction("👍");
+		const rows = plain(user.render(40));
+		expect(rows[0]).toContain("keep this text");
+		expect(rows.at(-1)).toContain("*");
+		expect(rows.at(-1)).toContain("👍");
+		user.setTranscriptAllocation(1);
+		expect(plain(user.render(40))).toHaveLength(1);
+		expect(plain(user.render(40))[0]).toContain("keep this text");
+		expect(user.renderTranscriptBlockEmergencyRow(40)).not.toContain("\x1b]133;");
+	});
+
+	it("preserves synthetic/system-attributed input rather than restyling it as YOU", () => {
+		const original = new UserMessageComponent("# Session recap\n\nRetained context", { synthetic: true }).render(40);
+		setConversationPresentation(policy);
+		expect(new UserMessageComponent("# Session recap\n\nRetained context", { synthetic: true }).render(40)).toEqual(original);
+	});
+
+	it("keeps Unicode, fenced code and links in the native Markdown renderer across widths", () => {
+		setConversationPresentation(policy);
+		const source = "你好 café e\u0301 👩‍💻\n\n[link](https://example.com) and `code`\n\n```ts\nconst n = 42;\n```";
+		for (const width of [8, 20, 40, 80]) {
+			const user = new UserMessageComponent(source);
