@@ -0,0 +1,44 @@
+/** Presentation only: native Markdown, message identity and streaming ownership stay with the host. */
+export interface ConversationPresentation {
+	readonly user?: {
+		/** Transparent prompt: a terminal rail/inset without vertical padding; a bare YOU head on native surfaces. */
+		readonly compact?: boolean;
+		/** Foreground styling for the rail only; defaults to the theme's accent. */
+		readonly accent?: (text: string) => string;
+	};
+	readonly assistant?: {
+		/** A quiet label before the first answer text, never on thinking-only or tool-only messages. */
+		readonly label?: string;
+		/** Foreground styling for the label only; defaults to the theme's muted color. */
+		readonly labelColor?: (text: string) => string;
+	};
+}
+
+let presentation: Readonly<ConversationPresentation> | undefined;
+
+/**
+ * Set the policy for newly constructed messages; undefined restores host defaults.
+ * Existing renderers retain their snapshot so published scrollback bytes never change.
+ * Interactive callers use ui.setConversationPresentation, which also replays settled history.
+ * Color callbacks must be deterministic for the active theme; do not close over mutable
+ * per-frame state, since labels can be published into immutable terminal scrollback.
+ * Returns false for an unchanged policy (including equivalent option objects).
+ */
+export function setConversationPresentation(next: ConversationPresentation | undefined): boolean {
+	if (
+		presentation?.user?.compact === next?.user?.compact &&
+		presentation?.user?.accent === next?.user?.accent &&
+		presentation?.assistant?.label === next?.assistant?.label &&
+		presentation?.assistant?.labelColor === next?.assistant?.labelColor
+	) return false;
+	presentation = next === undefined ? undefined : Object.freeze({
+		user: next.user ? Object.freeze({ ...next.user }) : undefined,
+		assistant: next.assistant ? Object.freeze({ ...next.assistant }) : undefined,
+	});
+	return true;
+}
+
+/** Immutable constructor snapshot; do not switch policies on an in-flight renderer. */
+export function getConversationPresentation(): Readonly<ConversationPresentation> | undefined {
+	return presentation;
+}
