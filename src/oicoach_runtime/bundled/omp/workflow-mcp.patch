diff --git a/packages/coding-agent/src/mcp/paveway-workspace.ts b/packages/coding-agent/src/mcp/paveway-workspace.ts
new file mode 100644
index 0000000..86ff329
--- /dev/null
+++ b/packages/coding-agent/src/mcp/paveway-workspace.ts
@@ -0,0 +1,83 @@
+import { constants } from "node:fs";
+import { lstat, open } from "node:fs/promises";
+import * as path from "node:path";
+import { isRecord } from "@oh-my-pi/pi-utils";
+import type { MCPServer } from "../capability/mcp";
+
+const NAME = "tijian";
+const MAX_CONFIG_BYTES = 65_536;
+
+type WorkflowTijian = { path: string } & ({ server: MCPServer } | { blocked: string });
+
+export function pavewayWorkspaceMcpPath(cwd: string): string | undefined {
+	const workspace = process.env.PAVEWAY_WORKFLOW_WORKSPACE;
+	if (!process.env.PAVEWAY_NATIVE_DATA || !workspace || !path.isAbsolute(workspace)) return undefined;
+	if (path.resolve(cwd) === path.resolve(workspace)) return undefined;
+	return path.join(workspace, ".omp", "mcp.json");
+}
+
+export async function readWorkflowTijian(cwd: string): Promise<WorkflowTijian | undefined> {
+	const filePath = pavewayWorkspaceMcpPath(cwd);
+	if (!filePath) return undefined;
+	const directory = path.dirname(filePath);
+	const blocked = (reason: string): WorkflowTijian => ({
+		path: filePath,
+		blocked: `Paveway disabled Tijian MCP: ${reason} (${filePath}).`,
+	});
+	try {
+		if (!(await lstat(directory)).isDirectory()) return blocked("Workflow Workspace .omp is not a real directory");
+		const file = await open(filePath, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+		let config: unknown;
+		try {
+			const info = await file.stat();
+			if (!info.isFile() || info.size > MAX_CONFIG_BYTES) return blocked("expected a regular MCP file up to 64 KiB");
+			const bytes = Buffer.allocUnsafe(info.size + 1);
+			let size = 0;
+			while (size < bytes.length) {
+				const { bytesRead } = await file.read(bytes, size, bytes.length - size, null);
+				if (bytesRead === 0) break;
+				size += bytesRead;
+			}
+			if (size !== info.size) return blocked("Workflow Workspace MCP config changed while being read");
+			config = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes.subarray(0, size)));
+		} finally {
+			await file.close();
+		}
+		if (!isRecord(config) || (config.mcpServers !== undefined && !isRecord(config.mcpServers))) {
+			return blocked("invalid Workflow Workspace MCP config");
+		}
+		if (Array.isArray(config.disabledServers) && config.disabledServers.includes(NAME)) {
+			return blocked("Workflow Workspace disabledServers contains tijian");
+		}
+		const server = config.mcpServers?.[NAME];
+		if (server === undefined) return undefined;
+		// Recognize exactly the command/permission format Paveway writes and edits.
+		if (!isRecord(server) || Object.keys(server).length !== 2 || typeof server.command !== "string" ||
+			!path.isAbsolute(server.command) || server.command.includes("\0") || !Array.isArray(server.args) ||
+			(server.args.length !== 0 && (server.args.length !== 1 || ![
+				"--read-only", "--write-policy=none", "--write-policy=managed", "--write-policy=full",
+			].includes(server.args[0])))) {
+			return blocked("unrecognized managed tijian definition; repair it in the Workflow Workspace");
+		}
+		return {
+			path: filePath,
+			server: {
+				name: NAME,
+				command: server.command,
+				args: server.args,
+				cwd: path.dirname(directory),
+				transport: "stdio",
+				_source: { provider: "native", providerName: "Paveway Workflow Workspace", path: filePath, level: "project" },
+			},
+		};
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+		return blocked("cannot read a valid Workflow Workspace MCP config");
+	}
+}
+
+export function matchesManagedDefinition(candidate: MCPServer, managed: MCPServer): boolean {
+	const { name: _name, _source, enabled: _enabled, command, args, transport, ...other } = candidate;
+	return (transport === undefined || transport === "stdio") && command === managed.command &&
+		Bun.deepEquals(args, managed.args) && Object.values(other).every(value => value === undefined);
+}
